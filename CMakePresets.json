{
    "version": 5,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base-ninja-configure",
            "hidden": true,
            "generator": "Ninja"
        },
        {
            "name": "base-native-release-like",
            "hidden": true,
            "inherits": "base-ninja-configure",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "DB_GLFW_PROVIDER": "vendored",
                "DB_GLFW_REQUIRED": "ON"
            }
        },
        {
            "name": "base-cross-release",
            "hidden": true,
            "inherits": "base-native-release-like",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "DB_ENABLE_LTO": "ON"
            }
        },
        {
            "name": "base-native-clang-release",
            "hidden": true,
            "inherits": "base-native-release-like",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_BUILD_TYPE": "Release",
                "DB_ENABLE_LTO": "ON"
            }
        },
        {
            "name": "base-native-gcc-release",
            "hidden": true,
            "inherits": "base-native-release-like",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_BUILD_TYPE": "Release",
                "DB_ENABLE_LTO": "ON"
            }
        },
        {
            "name": "base-native-clang-debug",
            "hidden": true,
            "inherits": "base-native-release-like",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_BUILD_TYPE": "Debug",
                "DB_ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "base-native-gcc-debug",
            "hidden": true,
            "inherits": "base-native-release-like",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_BUILD_TYPE": "Debug",
                "DB_ENABLE_SANITIZERS": "ON"
            }
        },
        {
            "name": "base-native-clang-relwithdebinfo",
            "hidden": true,
            "inherits": "base-native-release-like",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "DB_ENABLE_SANITIZERS": "OFF"
            }
        },
        {
            "name": "ninja-linux-native-clang-relwithdebinfo",
            "displayName": "Ninja (RelWithDebInfo)",
            "inherits": "base-native-clang-relwithdebinfo",
            "binaryDir": "${sourceDir}/build/relwithdebinfo"
        },
        {
            "name": "ninja-linux-native-clang-release",
            "displayName": "Ninja (Release)",
            "inherits": "base-native-clang-release",
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "ninja-linux-native-clang-debug",
            "displayName": "Ninja (Debug + ASan/UBSan)",
            "inherits": "base-native-clang-debug",
            "binaryDir": "${sourceDir}/build/debug"
        },
        {
            "name": "ninja-linux-native-gcc-release",
            "displayName": "Ninja (Release, GCC)",
            "inherits": "base-native-gcc-release",
            "binaryDir": "${sourceDir}/build/gcc-release"
        },
        {
            "name": "ninja-linux-native-gcc-debug",
            "displayName": "Ninja (Debug, GCC)",
            "inherits": "base-native-gcc-debug",
            "binaryDir": "${sourceDir}/build/gcc-debug"
        },
        {
            "name": "ninja-macos-native-clang-release",
            "displayName": "Ninja (Release, macOS)",
            "inherits": "base-native-clang-release",
            "binaryDir": "${sourceDir}/build/macos-release"
        },
        {
            "name": "ninja-macos-native-clang-debug",
            "displayName": "Ninja (Debug, macOS)",
            "inherits": "base-native-clang-debug",
            "binaryDir": "${sourceDir}/build/macos-debug"
        },
        {
            "name": "ninja-native-system-glfw-release",
            "displayName": "Ninja (Release, system GLFW fallback)",
            "inherits": "base-native-clang-release",
            "binaryDir": "${sourceDir}/build/system-glfw-release",
            "cacheVariables": {
                "DB_GLFW_PROVIDER": "system"
            }
        },
        {
            "name": "ninja-linux-gnu-i686-clang-release",
            "displayName": "Ninja (Release, Linux 32-bit SSE2 baseline, Clang cross)",
            "inherits": "base-native-clang-release",
            "binaryDir": "${sourceDir}/build/linux32",
            "cacheVariables": {
                "CMAKE_C_COMPILER_TARGET": "i686-pc-linux-gnu",
                "DB_TARGET_LINUX_32BIT": "ON"
            }
        },
        {
            "name": "ninja-linux-gnu-i686-clang-headless-release",
            "displayName": "Ninja (Release, Linux i686 headless, Clang)",
            "inherits": "base-native-clang-release",
            "binaryDir": "${sourceDir}/build/linux32-headless",
            "cacheVariables": {
                "CMAKE_C_COMPILER_TARGET": "i686-pc-linux-gnu",
                "DB_TARGET_LINUX_32BIT": "ON",
                "DB_BUILD_GLFW_WINDOW_DISPLAY": "OFF",
                "DB_GLFW_PROVIDER": "off",
                "DB_GLFW_REQUIRED": "OFF",
                "DB_BUILD_LINUX_KMS_ATOMIC_DISPLAY": "OFF",
                "DB_BUILD_VULKAN": "OFF",
                "DB_TEST_HEADLESS_ONLY": "ON",
                "DB_ENABLE_LTO": "OFF"
            }
        },
        {
            "name": "ninja-linux-gnu-i686-clang-headless-sanitize",
            "displayName": "Ninja (Debug ASan/UBSan, Linux i686 headless, Clang)",
            "inherits": "base-native-clang-debug",
            "binaryDir": "${sourceDir}/build/linux32-sanitize",
            "cacheVariables": {
                "CMAKE_C_COMPILER_TARGET": "i686-pc-linux-gnu",
                "DB_TARGET_LINUX_32BIT": "ON",
                "DB_BUILD_GLFW_WINDOW_DISPLAY": "OFF",
                "DB_GLFW_PROVIDER": "off",
                "DB_GLFW_REQUIRED": "OFF",
                "DB_BUILD_LINUX_KMS_ATOMIC_DISPLAY": "OFF",
                "DB_BUILD_VULKAN": "OFF",
                "DB_TEST_HEADLESS_ONLY": "ON",
                "DB_REQUIRE_SANITIZER_RUNTIME": "ON"
            }
        },
        {
            "name": "ninja-linux-gnu-i686-clang-full-release",
            "displayName": "Ninja (Release, Linux i686 full graphics, Clang)",
            "inherits": "ninja-linux-gnu-i686-clang-release",
            "binaryDir": "${sourceDir}/build/linux32-full",
            "cacheVariables": {
                "DB_TARGET_LINUX_ROOT": "$env{DB_TARGET_LINUX_ROOT}",
                "DB_GLFW_REQUIRED": "ON"
            }
        },
        {
            "name": "ninja-linux-gnu-i686-clang-full-sanitize",
            "displayName": "Ninja (Debug ASan/UBSan, Linux i686 full graphics, Clang)",
            "inherits": "base-native-clang-debug",
            "binaryDir": "${sourceDir}/build/linux32-full-sanitize",
            "cacheVariables": {
                "CMAKE_C_COMPILER_TARGET": "i686-pc-linux-gnu",
                "DB_TARGET_LINUX_32BIT": "ON",
                "DB_TARGET_LINUX_ROOT": "$env{DB_TARGET_LINUX_ROOT}",
                "DB_GLFW_REQUIRED": "ON",
                "DB_REQUIRE_SANITIZER_RUNTIME": "ON"
            }
        },
        {
            "name": "ninja-linux-musl-x86_64-release",
            "displayName": "Ninja (Release, Linux musl shared)",
            "inherits": "base-cross-release",
            "binaryDir": "${sourceDir}/build/musl-x86_64",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/DriverBenchLinuxMusl.cmake",
                "DB_TARGET_LINUX_MUSL": "ON",
                "DB_TARGET_LINUX_MUSL_TRIPLE": "x86_64-linux-musl",
                "DB_GLFW_REQUIRED": "OFF"
            }
        },
        {
            "name": "ninja-linux-musl-x86_64-static-release",
            "displayName": "Ninja (Release, Linux musl static)",
            "inherits": "base-cross-release",
            "binaryDir": "${sourceDir}/build/musl-static-x86_64",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/DriverBenchLinuxMusl.cmake",
                "DB_TARGET_LINUX_MUSL": "ON",
                "DB_TARGET_LINUX_MUSL_TRIPLE": "x86_64-linux-musl",
                "DB_TARGET_LINUX_MUSL_STATIC_LINK": "ON",
                "DB_BUILD_GLFW_WINDOW_DISPLAY": "OFF",
                "DB_GLFW_PROVIDER": "off",
                "DB_GLFW_REQUIRED": "OFF",
                "DB_BUILD_LINUX_KMS_ATOMIC_DISPLAY": "OFF",
                "DB_BUILD_VULKAN": "OFF"
            }
        },
        {
            "name": "ninja-linux-musl-i686-release",
            "displayName": "Ninja (Release, Linux musl shared + 32-bit)",
            "inherits": "base-cross-release",
            "binaryDir": "${sourceDir}/build/musl-i686",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/DriverBenchLinuxMusl.cmake",
                "DB_TARGET_LINUX_MUSL": "ON",
                "DB_TARGET_LINUX_32BIT": "ON",
                "DB_TARGET_LINUX_MUSL_TRIPLE": "i686-linux-musl",
                "DB_GLFW_REQUIRED": "OFF"
            }
        },
        {
            "name": "ninja-linux-musl-i686-static-release",
            "displayName": "Ninja (Release, Linux musl static + 32-bit)",
            "inherits": "base-cross-release",
            "binaryDir": "${sourceDir}/build/musl-static-i686",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/DriverBenchLinuxMusl.cmake",
                "DB_TARGET_LINUX_MUSL": "ON",
                "DB_TARGET_LINUX_32BIT": "ON",
                "DB_TARGET_LINUX_MUSL_TRIPLE": "i686-linux-musl",
                "DB_TARGET_LINUX_MUSL_STATIC_LINK": "ON",
                "DB_BUILD_LINUX_KMS_ATOMIC_DISPLAY": "OFF",
                "DB_BUILD_VULKAN": "OFF",
                "DB_BUILD_GLFW_WINDOW_DISPLAY": "OFF",
                "DB_GLFW_PROVIDER": "off",
                "DB_GLFW_REQUIRED": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "native-release",
            "configurePreset": "ninja-linux-native-clang-release",
            "jobs": 0
        },
        {
            "name": "native-sanitize",
            "configurePreset": "ninja-linux-native-clang-debug",
            "jobs": 0
        },
        {
            "name": "i686-headless-release",
            "configurePreset": "ninja-linux-gnu-i686-clang-headless-release",
            "jobs": 0
        },
        {
            "name": "i686-headless-sanitize",
            "configurePreset": "ninja-linux-gnu-i686-clang-headless-sanitize",
            "jobs": 0
        },
        {
            "name": "i686-full-release",
            "configurePreset": "ninja-linux-gnu-i686-clang-full-release",
            "jobs": 0
        },
        {
            "name": "i686-full-sanitize",
            "configurePreset": "ninja-linux-gnu-i686-clang-full-sanitize",
            "jobs": 0
        }
    ],
    "testPresets": [
        {
            "name": "native-release",
            "configurePreset": "ninja-linux-native-clang-release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "native-sanitize",
            "configurePreset": "ninja-linux-native-clang-debug",
            "filter": {
                "exclude": {
                    "label": "hardware"
                }
            },
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            },
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        },
        {
            "name": "i686-headless-release",
            "configurePreset": "ninja-linux-gnu-i686-clang-headless-release",
            "filter": {
                "include": {
                    "label": "unit|ir|headless|qemu"
                }
            },
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "i686-headless-sanitize",
            "configurePreset": "ninja-linux-gnu-i686-clang-headless-sanitize",
            "filter": {
                "include": {
                    "label": "unit|ir|headless|sanitizer"
                }
            },
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            },
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        },
        {
            "name": "i686-full-release",
            "configurePreset": "ninja-linux-gnu-i686-clang-full-release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "i686-full-sanitize",
            "configurePreset": "ninja-linux-gnu-i686-clang-full-sanitize",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            },
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        }
    ]
}
